2026-11-13T11:18:01.8057951Z     def set_module_tensor_to_device(
2026-11-13T11:18:01.8058206Z         module: nn.Module,
2026-11-13T11:18:01.8058432Z         tensor_name: str,
2026-11-13T11:18:01.8058674Z         device: Union[int, str, torch.device],
2026-11-13T11:18:01.8058966Z         value: Optional[torch.Tensor] = None,
2026-11-13T11:18:01.8059278Z         dtype: Optional[Union[str, torch.dtype]] = None,
2026-11-13T11:18:01.8059629Z         fp16_statistics: Optional[torch.HalfTensor] = None,
2026-11-13T11:18:01.8060068Z         tied_params_map: Optional[dict[int, dict[torch.device, torch.Tensor]]] = None,
2026-11-13T11:18:01.8060477Z         non_blocking: bool = False,
2026-11-13T11:18:01.8060728Z         clear_cache: bool = True,
2026-11-13T11:18:01.8060957Z     ):
2026-11-13T11:18:01.8061162Z         """
2026-11-13T11:18:01.8061588Z         A helper function to set a given tensor (parameter of buffer) of a module on a specific device (note that doing
2026-11-13T11:18:01.8062313Z         `param.to(device)` creates a new tensor not linked to the parameter, which is why we need this function).
2026-11-13T11:18:01.8062771Z     
2026-11-13T11:18:01.8062938Z         Args:
2026-11-13T11:18:01.8063142Z             module (`torch.nn.Module`):
2026-11-13T11:18:01.8063458Z                 The module in which the tensor we want to move lives.
2026-11-13T11:18:01.8063782Z             tensor_name (`str`):
2026-11-13T11:18:01.8064046Z                 The full name of the parameter/buffer.
2026-11-13T11:18:01.8064354Z             device (`int`, `str` or `torch.device`):
2026-11-13T11:18:01.8064795Z                 The device on which to set the tensor.
2026-11-13T11:18:01.8065101Z             value (`torch.Tensor`, *optional*):
2026-11-13T11:18:01.8065527Z                 The value of the tensor (useful when going from the meta device to any other device).
2026-11-13T11:18:01.8065966Z             dtype (`torch.dtype`, *optional*):
2026-11-13T11:18:01.8066719Z                 If passed along the value of the parameter will be cast to this `dtype`. Otherwise, `value` will be cast to
2026-11-13T11:18:01.8067282Z                 the dtype of the existing parameter in the model.
2026-11-13T11:18:01.8067648Z             fp16_statistics (`torch.HalfTensor`, *optional*):
2026-11-13T11:18:01.8068112Z                 The list of fp16 statistics to set on the module, used for 8 bit model serialization.
2026-11-13T11:18:01.8068725Z             tied_params_map (Dict[int, Dict[torch.device, torch.Tensor]], *optional*, defaults to `None`):
2026-11-13T11:18:01.8069406Z                 A map of current data pointers to dictionaries of devices to already dispatched tied weights. For a given
2026-11-13T11:18:01.8070123Z                 execution device, this parameter is useful to reuse the first available pointer of a shared weight on the
2026-11-13T11:18:01.8070674Z                 device for all others, instead of duplicating memory.
2026-11-13T11:18:01.8071054Z             non_blocking (`bool`, *optional*, defaults to `False`):
2026-11-13T11:18:01.8071671Z                 If `True`, the device transfer will be asynchronous with respect to the host, if possible.
2026-11-13T11:18:01.8072154Z             clear_cache (`bool`, *optional*, defaults to `True`):
2026-11-13T11:18:01.8072608Z                 Whether or not to clear the device cache after setting the tensor on the device.
2026-11-13T11:18:01.8073001Z         """
2026-11-13T11:18:01.8073189Z         # Recurse if needed
2026-11-13T11:18:01.8073417Z         if "." in tensor_name:
2026-11-13T11:18:01.8073665Z             splits = tensor_name.split(".")
2026-11-13T11:18:01.8073945Z             for split in splits[:-1]:
2026-11-13T11:18:01.8074221Z                 new_module = getattr(module, split)
2026-11-13T11:18:01.8074509Z                 if new_module is None:
2026-11-13T11:18:01.8074830Z                     raise ValueError(f"{module} has no attribute {split}.")
2026-11-13T11:18:01.8075174Z                 module = new_module
2026-11-13T11:18:01.8075428Z             tensor_name = splits[-1]
2026-11-13T11:18:01.8075664Z     
2026-11-13T11:18:01.8075968Z         if tensor_name not in module._parameters and tensor_name not in module._buffers:
2026-11-13T11:18:01.8076806Z             raise ValueError(f"{module} does not have a parameter or a buffer named {tensor_name}.")
2026-11-13T11:18:01.8077267Z         is_buffer = tensor_name in module._buffers
2026-11-13T11:18:01.8077569Z         old_value = getattr(module, tensor_name)
2026-11-13T11:18:01.8077831Z     
2026-11-13T11:18:01.8078320Z         # Treat the case where old_value (or a custom `value`, typically offloaded to RAM/disk) belongs to a tied group, and one of the weight
2026-11-13T11:18:01.8079221Z         # in the tied group has already been dispatched to the device, by avoiding reallocating memory on the device and just copying the pointer.
2026-11-13T11:18:01.8079794Z         if (
2026-11-13T11:18:01.8079985Z             value is not None
